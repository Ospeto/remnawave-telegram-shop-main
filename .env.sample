# ─────────────────────────────────────────────────────────────
#  Remnawave Telegram Shop — Environment Configuration
#
#  TIP: Run `bash setup.sh` for an interactive wizard that
#       fills this out automatically.
# ─────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_ID=123456789

# ── Domain & SSL (optional bundled Caddy profile) ──────────
DOMAIN_NAME=shop.example.com
ACME_EMAIL=admin@example.com

# ── Remnawave Panel ─────────────────────────────────────────
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=your_panel_api_token
REMNAWAVE_MODE=remote
REMNAWAVE_TAG=

# ── Subscription Plans ──────────────────────────────────────
# Format: Label|Days|Price|TrafficGB (0=unlimited), comma-separated
PLANS=Unlimited|30|10000|0,Unlimited|90|28000|0,Unlimited|180|52000|0
CURRENCY=MMK

# ── Payment — CryptoPay (currently disabled) ───────────────
CRYPTO_PAY_ENABLED=false
CRYPTO_PAY_TOKEN=your_cryptopay_token
CRYPTO_PAY_URL=https://pay.crypt.bot

# ── Payment — Mobile Banking (KPay/WavePay/AyaPay) ──────────
MOBILE_BANKING_ENABLED=false
MOBILE_BANKING_PHONE=09xxxxxxxxx
# Screenshot verification requires either OPENROUTER_API_KEY or GEMINI_API_KEY.
# OpenRouter is the default primary provider in this repository.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional direct Gemini provider configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Optional OpenRouter fallback model, using the same OpenRouter API key.
OPENROUTER_FALLBACK_MODEL=google/gemini-3.1-flash-lite-preview
# Leave empty for single-provider mode.
# Valid values: openrouter, gemini
# When using VISION_PROVIDER_FALLBACK=openrouter, OPENROUTER_FALLBACK_MODEL is required.
VISION_PROVIDER_FALLBACK=openrouter
# Retries per provider before failover to next provider.
VISION_RETRY_ATTEMPTS=1
# Set to 3 when fallback is enabled; otherwise 2 is enough.
VISION_RETRY_MAX_ATTEMPTS=3
# Minimum confidence required to accept a screenshot analysis result.
# Lower value = fewer false negatives, more permissive acceptance.
VISION_ACCEPT_CONFIDENCE_THRESHOLD=0.55
# Minimum confidence required before a semantic invalid result is treated as a hard reject.
# Higher value = fewer false negatives, more invalid screenshots become "ask for clearer screenshot".
VISION_REJECT_CONFIDENCE_THRESHOLD=0.90

# ── Traffic & Referral ──────────────────────────────────────
# Reset strategy: DAY, WEEK, MONTH, NO_RESET
TRAFFIC_LIMIT_RESET_STRATEGY=MONTH
REFERRAL_DAYS=7

# ── Trial ────────────────────────────────────────────────────
TRIAL_DAYS=0
TRIAL_TRAFFIC_LIMIT=20
TRIAL_TRAFFIC_LIMIT_RESET_STRATEGY=MONTH
TRIAL_INTERNAL_SQUADS=
TRIAL_EXTERNAL_SQUAD_UUID=
TRIAL_REMNAWAVE_TAG=

# ── Squads ───────────────────────────────────────────────────
# Comma-separated UUIDs. Leave empty for all squads.
SQUAD_UUIDS=87dfe20c-e812-4c43-b424-2f5bb6458329
EXTERNAL_SQUAD_UUID=

# ── Optional URLs (leave empty to hide button) ───────────────
SERVER_STATUS_URL=
SUPPORT_URL=
FEEDBACK_URL=
CHANNEL_URL=
TOS_URL=

# ── Access Control ───────────────────────────────────────────
# Comma-separated Telegram IDs
BLOCKED_TELEGRAM_IDS=
WHITELISTED_TELEGRAM_IDS=

# ── Mini App URL ─────────────────────────────────────────────
# Set this to your public HTTPS URL to enable the Telegram Mini App
MINI_APP_URL=
# Controls whether the bot should expose the web-app style connect flow.
IS_WEB_APP_LINK=true

# ── App Runtime ──────────────────────────────────────────────
HEALTH_CHECK_PORT=8080
# Optional runtime toggle. Leave false unless you intentionally enable auto-payment behavior.
ENABLE_AUTO_PAYMENT=false

# ── Database (don't change unless you know what you're doing)
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── Backups ──────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_SCHEDULE_CRON=10 0 * * *
BACKUP_TIMEZONE=Asia/Rangoon
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_LOCAL_FILES=7
BACKUP_SEND_TO_TELEGRAM=true
# Keep false for normal production operation. Live restore is disabled in the running bot process.
BACKUP_RESTORE_ENABLED=false
BACKUP_CONFIRM_TTL_MINUTES=10
BACKUP_JOB_TIMEOUT_SECONDS=900
BACKUP_RESTORE_TIMEOUT_SECONDS=1800

# ── Advanced ─────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
# Additional headers for Remnawave API (format: key1:val1;key2:val2)
REMNAWAVE_HEADERS=
# Trust X-Forwarded-For from private-network proxies only when you control the proxy chain.
TRUST_PRIVATE_PROXY_HEADERS=false
